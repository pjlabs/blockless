<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.pjlabs</groupId>
        <artifactId>blockless-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>blockless-continuations</artifactId>
    <name>blockless continuations</name>
    <properties>
        <javaflow.version>2.9.0</javaflow.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>io.github.pjlabs</groupId>
            <artifactId>blockless</artifactId>
        </dependency>
        <dependency>
            <groupId>net.tascalate.javaflow</groupId>
            <artifactId>net.tascalate.javaflow.api</artifactId>
            <version>${javaflow.version}</version>
        </dependency>
        <dependency>
            <groupId>net.tascalate.javaflow</groupId>
            <artifactId>net.tascalate.javaflow.providers.core</artifactId>
            <version>${javaflow.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enhance-continuations</id>
                        <phase>process-classes</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>io.github.pjlabs.blockless.continuations.ContinuationEnhancer</mainClass>
                            <arguments><argument>${project.build.outputDirectory}</argument></arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>enhance-test-continuations</id>
                        <phase>process-test-classes</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>io.github.pjlabs.blockless.continuations.ContinuationEnhancer</mainClass>
                            <classpathScope>test</classpathScope>
                            <arguments><argument>${project.build.testOutputDirectory}</argument></arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
