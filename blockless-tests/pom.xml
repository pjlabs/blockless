<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.pjlabs</groupId>
        <artifactId>blockless-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>blockless-tests</artifactId>
    <packaging>jar</packaging>
    <name>blockless-tests</name>

    <properties>
        <!-- Integration tests only: never publish this artifact (e.g. GitHub Packages). -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.pjlabs</groupId>
            <artifactId>blockless</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.pjlabs</groupId>
            <artifactId>blockless-context-slf4j</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.pjlabs</groupId>
            <artifactId>blockless-context-grpc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.pjlabs</groupId>
            <artifactId>blockless-context-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
